<footer class="site-footer">
  <div class="container">
    <div class="footer-inner">
      <div class="footer-brand">
        <svg class="footer-logo" viewBox="0 0 64 64" width="44" height="44" aria-hidden="true">
          <rect width="64" height="64" fill="#fff" />
          <path d="M11 30 L32 12 L53 30 V53 H11 Z" fill="none" stroke="#ec3013" stroke-width="4" stroke-linejoin="miter" />
          <path d="M42 20 V13 H47 V25" fill="none" stroke="#ec3013" stroke-width="4" stroke-linejoin="miter" />
          <path d="M32 24.5 C32 24.5 35.7 31.5 38.1 35.9 A8 8 0 1 1 25.9 35.9 C28.3 31.5 32 24.5 32 24.5 Z" fill="#ec3013" />
        </svg>
        <div>
          <p class="footer-name">누수응급센터</p>
          <p class="footer-slogan">빠른 대응이 피해를 줄입니다</p>
        </div>
      </div>
      <div class="footer-contact">
        <p class="footer-label">24시간 365일 긴급출동</p>
        <a class="footer-phone" href="tel:16442667">1644-2667</a>
      </div>
    </div>
    <div class="footer-bottom">
      <ul class="footer-services">
        <li>누수탐지</li>
        <li>열화상 카메라 진단</li>
        <li>배관내시경 검사</li>
        <li>누수공사 및 보수</li>
        <li>보험처리 지원</li>
      </ul>
      {{#if business.hasFooterDetails}}
        <p class="footer-biz">
          {{#if business.name}}<span>상호 {{business.name}}</span>{{/if}}
          {{#if business.owner}}<span>대표 {{business.owner}}</span>{{/if}}
          {{#if business.regNo}}<span>사업자등록번호 {{business.regNo}}</span>{{/if}}
          {{#if business.address}}<span>주소 {{business.address}}</span>{{/if}}
          {{#if business.email}}<span>이메일 <a href="mailto:{{business.email}}">{{business.email}}</a></span>{{/if}}
        </p>
      {{/if}}
      <div class="footer-legal">
        <a class="footer-privacy" href="/privacy">개인정보 처리방침</a>
        <p>© 누수응급센터 LEAK EMERGENCY CENTER</p>
      </div>
    </div>
  </div>
</footer>
