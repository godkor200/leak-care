generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model LeakReport {
  id                 Int              @id @default(autoincrement())
  name               String
  phone              String
  // 화면 표시용 전체 주소 (기본 주소 + 상세주소)
  address            String
  addressDetail      String?
  // 주소 검색(카카오 우편번호)으로 고른 경우에만 채워진다
  postalCode         String?
  roadAddress        String?
  jibunAddress       String?
  sido               String?
  sigungu            String?
  location           String?
  occurredAt         String?
  damageScope        String?
  description        String?
  urgency            String
  status             String           @default("접수완료")
  // 개인정보 수집·이용 동의 시각. 동의 절차 도입 전 접수 건은 비어 있다.
  privacyConsentedAt DateTime?
  createdAt          DateTime         @default(now())
  files              LeakReportFile[]
}

model LeakReportFile {
  id           Int        @id @default(autoincrement())
  leakReportId Int
  leakReport   LeakReport @relation(fields: [leakReportId], references: [id])
  url          String
  type         String
  createdAt    DateTime   @default(now())
}
