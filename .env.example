DATABASE_URL="file:./dev.db"
AWS_REGION=ap-northeast-2
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SLACK_BOT_TOKEN=
SLACK_REPORT_CHANNEL_ID=
SLACK_EMERGENCY_CHANNEL_ID=

# 사업자 정보 (모두 선택. 설정한 값만 푸터와 개인정보 처리방침에 표시)
BUSINESS_NAME=
BUSINESS_OWNER=
BUSINESS_REG_NO=
BUSINESS_ADDRESS=
BUSINESS_EMAIL=
PRIVACY_OFFICER_NAME=
PRIVACY_OFFICER_CONTACT=
# 개인정보 처리방침 시행일 (예: 2026-10-01)
PRIVACY_POLICY_EFFECTIVE_DATE=

# 검색엔진 (SITE_URL 기본값: https://nusu-emergency.co.kr, 끝에 / 없이)
SITE_URL=
# 네이버 서치어드바이저 / 구글 서치콘솔 HTML 태그 소유 확인 값 (content 값만)
NAVER_SITE_VERIFICATION=
GOOGLE_SITE_VERIFICATION=
# sitemap.xml의 lastmod (선택, 예: 2026-10-01). 비워 두면 lastmod를 넣지 않는다
SITEMAP_LASTMOD=
